{
    "version": "2.0.0",
    "description": "Real-time system resource monitoring HUD for Windows 11 (CPU, GPU, memory, disk I/O, network)",
    "homepage": "https://github.com/aviscaerulea/sysmeters",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/aviscaerulea/sysmeters/releases/download/v2.0.0/sysmeters-v2.0.0-x64.zip",
            "hash": "1d2a0726798319db5bd5f7ad2f7b81ccf9625a1f77c11100c4cce8e9c523e9c1"
        }
    },
    "bin": "sysmeters.exe",
    "pre_install": "taskkill /f /im sysmeters.exe 2>$null; $LASTEXITCODE = 0; Wait-Process -Name sysmeters -Timeout 10 -ErrorAction SilentlyContinue",
    "post_install": "Start-Process -FilePath \"$dir\\sysmeters.exe\" -WorkingDirectory $dir -WindowStyle Hidden",
    "pre_uninstall": "taskkill /f /im sysmeters.exe 2>$null; $LASTEXITCODE = 0; Wait-Process -Name sysmeters -Timeout 10 -ErrorAction SilentlyContinue",
    "persist": [
        "sysmeters.toml",
        "sysmeters.local.toml"
    ],
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aviscaerulea/sysmeters/releases/download/v$version/sysmeters-v$version-x64.zip"
            }
        }
    }
}
