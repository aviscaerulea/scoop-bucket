{
    "version": "1.11.0",
    "description": "Ultra-lightweight Windows CLI audio player",
    "homepage": "https://github.com/aviscaerulea/minply",
    "license": "MIT",
    "architecture": {
        "64bit": {
            "url": "https://github.com/aviscaerulea/minply/releases/download/v1.11.0/minply-1.11.0-x64.zip",
            "hash": "451477cea53bb0cd538408d3092c6fc26741edb0e397785b682cd6c2bb1be035"
        }
    },
    "bin": "minply.exe",
    "pre_install": [
        "$p = Get-Process -Name minply -ErrorAction SilentlyContinue | Where-Object { $_.Path -like \"$(Split-Path $dir)\\*\" }; if ($p) { $p | Stop-Process -Force; $p | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue }",
        "if ((Test-Path \"$persist_dir\\minply.toml\") -and -not (Test-Path \"$persist_dir\\minply.local.toml\")) { Move-Item \"$persist_dir\\minply.toml\" \"$persist_dir\\minply.local.toml\" }"
    ],
    "persist": [
        "minply.local.toml",
        "logs"
    ],
    "pre_uninstall": "$p = Get-Process -Name minply -ErrorAction SilentlyContinue | Where-Object { $_.Path -like \"$(Split-Path $dir)\\*\" }; if ($p) { $p | Stop-Process -Force; $p | Wait-Process -Timeout 10 -ErrorAction SilentlyContinue }",
    "post_install": "Start-Process -FilePath \"$dir\\minply.exe\" -ArgumentList '--tray' -WorkingDirectory $dir",
    "checkver": "github",
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/aviscaerulea/minply/releases/download/v$version/minply-$version-x64.zip"
            }
        }
    }
}
